{
  "name": "@onetickets/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "certs",
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import ./dist/instrument.js dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "node src/database/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/client-sesv2": "^3.1163.0",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@onetickets/shared": "workspace:*",
    "@sentry/nestjs": "^11.11.0",
    "cookie": "^2.0.2",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "10.3.1",
    "openid-client": "^6.8.9",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.3",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
