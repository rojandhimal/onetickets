# The api's own connection: a login role granted ot_app (row-level security applies).
DATABASE_URL=postgres://onetickets_app:onetickets_app@localhost:5432/onetickets
# Schema owner, used only by `pnpm --filter @onetickets/api migrate`.
MIGRATION_DATABASE_URL=postgres://onetickets:onetickets@localhost:5432/onetickets
PORT=3001
# Origin of the web app: sign-in links point here and state-changing requests must come from it.
WEB_URL=http://localhost:3000
# Only for local http. Production refuses to start with this set to false.
SESSION_COOKIE_SECURE=false
# ses in AWS (needs EMAIL_FROM_DOMAIN). Locally, smtp sends to Mailpit (inbox at
# http://localhost:8025) and console prints mail, including sign-in links; both are refused in
# production.
MAIL_TRANSPORT=console
# SMTP_HOST=localhost
# SMTP_PORT=1025
# Proxies that append the client address to X-Forwarded-For. 0 locally: the web app's /api
# rewrite forwards the header unchanged, so trusting it would let anyone pick their IP.
# 1 behind the AWS load balancer, 2 once Cloudflare is in front too.
TRUST_PROXY_HOPS=0
# Sign-in emails the whole service may send in a rolling hour (protects SES reputation).
MAGIC_LINK_HOURLY_CAP=300
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts MFA secrets at rest.
MFA_ENCRYPTION_KEY=
# Google sign-in. Leave empty until the OAuth client exists; the button then shows "unavailable".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to WEB_URL/api/auth/google/callback. Register this exact URL in Google Cloud.
# GOOGLE_REDIRECT_URI=
