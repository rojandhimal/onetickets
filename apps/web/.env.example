# Where Next forwards /api/* and where server components fetch from.
API_URL=http://localhost:3001

# Shows the event templates on /organiser as links. Off until the S1-1 wizard ships.
FEATURE_EVENT_WIZARD=false

# Sentry. Leave the DSN empty to keep Sentry off (local dev and tests). One DSN for every
# environment, passed at build time. The environment comes from APP_ENV on the server and the
# hostname in the browser, so the same image works in staging and production.
APP_ENV=development
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Build-time only, for source map upload in CI.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
