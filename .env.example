# Optional settings for `docker compose up`. Copy to .env and uncomment what you need.

# Public address of the site, used in links inside emails. Set it to your
# trycloudflare.com address when sharing a demo (see README.md).
# WEB_URL=https://example.trycloudflare.com

# Turn on the unfinished create-event wizard.
# FEATURE_EVENT_WIZARD=true
